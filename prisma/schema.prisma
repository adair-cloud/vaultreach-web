generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  // Google OAuth returns this field — must be present or PrismaAdapter throws
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String     @id @default(cuid())
  name                  String?
  email                 String?    @unique
  emailVerified         DateTime?
  image                 String?
  apolloApiKey          String?    @db.Text
  hasOnboarded          Boolean    @default(false)
  
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  
  accounts              Account[]
  sessions              Session[]
  campaigns             Campaign[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String    @default("inactive") // active, inactive
  targetIndustry        String
  targetTitles          String
  employeeRange         String
  targetLocations       String
  websiteUrl            String?
  // AI Brain settings — stored in their own columns, not hijacking ICP fields
  tone                  String    @default("professional")
  rules                 String?   @db.Text
  // Scheduling Settings
  timezone              String    @default("America/New_York")
  sendWindowStart       Int       @default(9)  // 9 AM
  sendWindowEnd         Int       @default(17) // 5 PM
  sendDays              String    @default("1,2,3,4,5") // Mon-Fri
  // Worker heartbeat — updated by the Python worker each cycle
  lastPing              DateTime?
  // Worker run summary — JSON blob written by worker each cycle for visibility
  lastRunSummary        Json?     // { leadsEvaluated, leadsSkipped, draftsCreated, errors[], runAt }
  // Draft Mode
  draftMode             Boolean   @default(true)
  autoApproveHours      Int?      // null = never auto-approve; 24 = approve after 24hrs
  dailySendLimit        Int       @default(20) // per-campaign daily cap
  // Campaign identity (for multi-campaign support)
  name                  String    @default("My Campaign")
  // Zapier / CRM webhook — POST on Hot reply
  webhookUrl            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  analytics             Analytics[]
  replies               Reply[]
  leads                 Lead[]
  drafts                Draft[]
  excludedLeads         ExcludedLead[]
}

model Draft {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  leadEmail     String
  leadFirstName String?
  leadCompany   String?
  leadTitle     String?  // Job title for richer preview card
  leadLinkedIn  String?  // LinkedIn URL for lead verification
  
  emailSubject  String?  // Subject line for preview & analytics
  emailBody     String   @db.Text
  status        String   @default("pending") // pending, approved, rejected, sent
  followUpNum   Int      @default(0)  // 0=initial, 1=Day3, 2=Day7
  sentAt        DateTime?  // Timestamp when email was actually delivered
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Analytics {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  emailsSent      Int      @default(0)
  replies         Int      @default(0)
  meetings        Int      @default(0)
  draftsApproved  Int      @default(0)
  draftsRejected  Int      @default(0)
  emailsBounced   Int      @default(0)
}

model Reply {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderName      String
  senderRole      String?  // e.g. "CEO at Horizon Roofers"
  preview         String   @db.Text
  score           String   @default("Warm") // Hot | Warm | Cold
  gmailMessageId  String?  // Gmail message ID for deduplication
  receivedAt      DateTime @default(now())

  @@unique([campaignId, gmailMessageId])
}

enum LeadStatus {
  COLD
  FOLLOW_UP
  REPLIED
  BOUNCED
}

model Lead {
  id            String     @id @default(uuid())
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  apolloId      String?    // Apollo person ID — used for pre-enrichment dedup to prevent credit burn
  status        LeadStatus @default(COLD)
  stepIndex     Int        @default(1)
  lastContacted DateTime?
}

model GlobalSuppression {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String   @default("unsubscribe")
  createdAt DateTime @default(now())
}

// Per-campaign lead exclusion list (#3 — manual block by user)
model ExcludedLead {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email       String
  reason      String?  // "replied", "not_interested", "wrong_person", "competitor", "manual"
  excludedAt  DateTime @default(now())

  @@unique([campaignId, email])
}

// Trial drip email tracking — one row per (userId, emailType) so each email fires exactly once
model TrialEmail {
  id        String   @id @default(cuid())
  userId    String
  emailType String   // "day1" | "day3" | "day7" | "day12" | "day14"
  sentAt    DateTime @default(now())

  @@unique([userId, emailType])
}
